rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and schema defense
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Public read for content collections; strict authenticated write with validation
    match /blogs/{doc} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title', 'category'])
        && isValidString(request.resource.data.title, 2, 200);
      allow delete: if isAuthenticated();
    }

    match /projects/{doc} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title'])
        && isValidString(request.resource.data.title, 2, 200);
      allow delete: if isAuthenticated();
    }

    match /packages/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /tutorials/{doc=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Administrative collections - Strictly private
    match /settings/{doc} {
      allow read, write: if isAuthenticated();
    }

    match /bot_logs/{doc} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{doc} {
      allow read, write: if isAuthenticated();
    }

    // Default catch-all: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
